# EditorConfig：统一编辑器行为（https://editorconfig.org）
# 口径与 CONTRIBUTING「硬性要求」一致：UTF-8 无 BOM、LF 行尾、包内相对路径。
root = true

[*]
charset = utf-8             # 无 BOM；带 BOM 的文件 git diff 会出现首行乱码
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4

[*.{md,yml,yaml,json,cff,tex}]
indent_size = 2

# 中文注释：md / py / yaml 内可直接书写中文，统一以无 BOM 的 UTF-8 保存；
# 切勿用 GBK / GB18030 落盘——非 UTF-8 编码的中文在跨平台/agent 读取时会乱码。
